# ─────────────────────────────────────────────────────────────
#  Webinar Platform — Production Environment Configuration
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
HTTP_PORT=5173
API_PORT=4000
WEB_PORT=3000
SERVER_NAME=_
WEB_ORIGIN=http://localhost:5173

# Database (sqlite or postgresql)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./prod.db"
POSTGRES_USER=webinar
POSTGRES_DB=webinar
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Auth & Secrets
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@webinar.local
ADMIN_PASSWORD=

# Razorpay (optional - leave blank for mock mode)
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=
NEXT_PUBLIC_RZP_KEY_ID=

# mediasoup / WebRTC
PUBLIC_IP=127.0.0.1
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_WORKERS=1

# TURN / coturn
TURN_URL=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_USERNAME=webinar
TURN_PASSWORD=
TURN_REALM=webinar.local
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# Client-facing URLs (can be empty to use current origin)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=webinars@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REMINDERS_ENABLED=true


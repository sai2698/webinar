# Public API + Socket.IO origin for the staging environment.
SOCKET_URL=https://staging-api.example.com
WEB_ORIGIN=http://127.0.0.1:4173
WEBINAR_SLUG=load-test-webinar
TOKENS_FILE=./tokens.json
# Set this only on ONE agent to publish the host's synthetic audio/video.
HOST_TOKEN=
# Required safety acknowledgement. Never point a 5k run at production without approval.
LOADTEST_CONFIRM_TARGET=I_OWN_THIS_STAGING_SYSTEM
# Per-agent limit. Start at 10, then 25, 50, 100. Do not set 5000 on one machine.
MAX_VIEWERS=100
RAMP_UP_PER_SECOND=2
RUN_DURATION_SECONDS=180
HEADLESS=true
CHAT_EVERY_SECONDS=60

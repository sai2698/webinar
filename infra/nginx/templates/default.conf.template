map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream webinar_web {
    server 127.0.0.1:${WEB_PORT};
}

upstream webinar_api {
    server 127.0.0.1:${API_PORT};
}

server {
    listen ${HTTP_PORT};
    server_name ${SERVER_NAME};

    client_max_body_size 30m;

    # Gzip compression for faster loading on 1 vCPU
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # ── Next.js Frontend ──────────────────────────────────────
    location / {
        proxy_pass http://webinar_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # ── Uploaded assets (Banners, etc.) ───────────────────────
    location /uploads/ {
        proxy_pass http://webinar_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Socket.IO (WebSocket upgrade required) ────────────────
    location /socket.io/ {
        proxy_pass http://webinar_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # ── REST API ──────────────────────────────────────────────
    location /api/ {
        proxy_pass http://webinar_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

